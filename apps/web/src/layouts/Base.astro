---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The page's language. Pages in one language (the landing page) set it; the editor picks its own at run time. */
  lang?: "es" | "en";
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const { title, lang } = Astro.props;
const description =
  Astro.props.description ??
  (lang === "en"
    ? "A CV editor on Typst: forms, a live preview and exports to PDF, Word, LaTeX and more. All in your browser."
    : "Editor de CV sobre Typst: formularios, vista previa en vivo y exportación a PDF, Word, LaTeX y más. Todo en tu navegador.");
const site = Astro.site ?? Astro.url;
const alternates = lang && { es: new URL(base, site).href, en: new URL(`${base}en/`, site).href };
const manifest = `${base}${lang === "en" ? "manifest.en.webmanifest" : "manifest.webmanifest"}`;
// What X, WhatsApp, Telegram and LinkedIn show when a link is shared; they need absolute URLs. The images come from
// scripts/og-image.html. The editor picks its language at run time, so its preview is the Spanish one.
const preview =
  lang === "en"
    ? {
        image: "og.en.jpg",
        locale: "en_US",
        alternate: "es_AR",
        alt: "Foja: your CV in Typst, without writing code. Next to it, the editor with a CV in its preview.",
      }
    : {
        image: "og.jpg",
        locale: "es_AR",
        alternate: "en_US",
        alt: "Foja: tu CV en Typst, sin escribir código. Al lado, el editor con un CV en la vista previa.",
      };
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}${preview.image}`, site).href;
---

<html lang={lang ?? "es"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={manifest} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="es" href={alternates.es} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    <!--
      The language: the one picked in a selector (saved as foja.language, like the editor does), or else Spanish when
      any of the browser's languages is Spanish and English otherwise (the rule of editor/i18n.ts). A landing page in
      the other language sends the visitor to this one's twin; crawlers stay, so both versions get indexed. The
      editor gets the manifest in its language.
    -->
    <script is:inline define:vars={{ base, page: lang ?? null }}>
      let saved = null;
      try {
        saved = JSON.parse(localStorage.getItem("foja.language"));
      } catch {}
      if (saved !== "es" && saved !== "en") saved = null;
      const preferred = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
      const chosen = saved || (preferred.some((l) => /^es(-|$)/i.test(l)) ? "es" : "en");
      const crawler = /bot|crawl|spider|slurp|facebookexternalhit|lighthouse/i.test(navigator.userAgent);
      if (page && chosen !== page && (saved || !crawler)) location.replace(chosen === "en" ? base + "en/" : base);
      if (!page) {
        document.documentElement.lang = chosen;
        if (chosen === "en") document.querySelector('link[rel="manifest"]').href = base + "manifest.en.webmanifest";
      }
      document.addEventListener("click", (e) => {
        const link = e.target instanceof Element && e.target.closest("a[data-lang]");
        if (!link) return;
        try {
          localStorage.setItem("foja.language", JSON.stringify(link.dataset.lang));
        } catch {}
      });
    </script>
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="Foja" />
    <meta name="theme-color" content="#1f5f5b" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Foja" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={preview.locale} />
    {lang && <meta property="og:locale:alternate" content={preview.alternate} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={preview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={preview.alt} />
    <slot name="head" />
  </head>
  <body class="h-full bg-bg text-ink">
    <slot />
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ base }}>
          if ("serviceWorker" in navigator && !window.__TAURI__) navigator.serviceWorker.register(base + "sw.js", {scope: base});
        </script>
      )
    }
  </body>
</html>
