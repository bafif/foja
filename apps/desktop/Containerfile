# The Linux build of the desktop app, for scripts/desktop.sh: Rust, Node and the WebKitGTK that Tauri builds against.
# GitHub's workflow (.github/workflows/desktop.yml) installs the same on its runners instead.
# On bookworm, so the .deb and the AppImage need no newer glibc than Debian 12's and Ubuntu 22.04's.
FROM docker.io/library/rust:1-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libxdo-dev \
        libssl-dev patchelf file xdg-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker.io/library/node:26-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=docker.io/library/node:26-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
